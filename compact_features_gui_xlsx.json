{
  "version": 1,
  "mode": "xlsx",
  "lib": "compact_features_trace_build/simv.daidir/kdb.elab++",
  "module": "CFTarget,CFAuxTarget",
  "keywords": "CFKeySrc,CFKeySink",
  "ports": "drv_bits[0],drv_bits[1],drv_bits[2],drv_chain,drv_port,drv_wide_bit,drv_ternary_stop,drv_const,drv_reg,drv_float,drv_noise,load_bus[2],load_bus[6],load_port,load_reg,load_no,aux_in,aux_float,aux_out,aux_unused",
  "template": "compact_features_trace_template.xlsx",
  "xlsx_output": "compact_features_annotated.xlsx",
  "log_file": "compact_features_gui_xlsx.log",
  "sheet": "",
  "workdir": "",
  "subsystem_level": "2",
  "stream": true,
  "no_params": false,
  "strict_params": false,
  "keep_workdir": false,
  "regcombo_as_keyword": true,
  "match_cache_size": "100000",
  "keyword_batch_size": "1",
  "keyword_continue_on_error": false,
  "keyword_log_instances": true,
  "const_source_fallback": true,
  "const_trace_depth": "8",
  "assign_trace_depth": "10",
  "assign_expr_trace_depth": "4",
  "trace_debug": false,
  "csv_output": "compact_features_filtered.csv",
  "raw_full_output": "compact_features_raw_full.csv",
  "raw_module_output": "compact_features_raw_module.csv",
  "srcfile": ""
}
