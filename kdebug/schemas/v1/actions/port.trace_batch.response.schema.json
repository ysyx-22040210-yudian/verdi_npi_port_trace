{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kdebug.port.trace_batch.response.v1",
  "title": "port.trace_batch response",
  "type": "object",
  "required": ["api_version", "ok", "action", "summary", "data"],
  "properties": {
    "api_version": {"type": "string", "enum": ["kdebug.v1"]},
    "request_id": {"type": "string"},
    "ok": {"type": "boolean"},
    "action": {"type": "string", "enum": ["port.trace_batch"]},
    "summary": {"type": "object", "additionalProperties": true},
    "data": {
      "type": "object",
      "required": [
        "module", "requested_ports", "traced_ports", "selection_mode",
        "full_rows", "boundary_rows",
        "evidence", "errors", "truncated", "stats"
      ],
      "properties": {
        "module": {"type": "string"},
        "requested_ports": {"type": "array", "items": {"type": "string"}},
        "traced_ports": {"type": "array", "items": {"type": "string"}},
        "selection_mode": {"type": "string", "enum": ["all", "explicit"]},
        "full_rows": {"type": "array", "items": {"$ref": "#/$defs/trace_row"}},
        "boundary_rows": {"type": "array", "items": {"$ref": "#/$defs/trace_row"}},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "errors": {"type": "array", "items": {"$ref": "#/$defs/item_error"}},
        "truncated": {"type": "boolean"},
        "stats": {"type": "object", "additionalProperties": true},
        "summary": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": true
    },
    "findings": {"type": "array"},
    "warnings": {"type": "array"},
    "error": {},
    "meta": {"type": "object"}
  },
  "$defs": {
    "trace_row": {
      "type": "object",
      "required": ["inst_full_name", "port_name", "port_dir", "role", "signal_full_name"],
      "properties": {
        "inst_full_name": {"type": "string", "minLength": 1},
        "port_name": {"type": "string", "minLength": 1},
        "port_dir": {"type": "string", "enum": ["input", "output", "inout", "unknown"]},
        "role": {"type": "string", "enum": ["driver", "load"]},
        "signal_full_name": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": [
        "kind", "value", "method", "role", "port_path", "const_full_path",
        "effective", "constant", "provenance"
      ],
      "properties": {
        "kind": {"type": "string", "enum": ["constant"]},
        "value": {"type": "string", "pattern": "^Const:.+"},
        "method": {"type": "string", "minLength": 1},
        "role": {"type": "string", "enum": ["driver"]},
        "port_path": {"type": "string", "minLength": 1},
        "const_full_path": {"type": "string", "minLength": 1},
        "effective": {"type": "boolean"},
        "effective_candidate": {"type": "boolean"},
        "rejection_reason": {"type": "string"},
        "constant": {
          "type": "object",
          "required": ["value", "effective"],
          "properties": {
            "value": {"type": "string", "pattern": "^Const:.+"},
            "effective": {"type": "boolean"}
          },
          "additionalProperties": true
        },
        "provenance": {
          "type": "object",
          "required": ["origin", "unconditional", "path", "source"],
          "properties": {
            "origin": {"type": "string", "minLength": 1},
            "unconditional": {"type": "boolean"},
            "path": {
              "type": "array",
              "minItems": 2,
              "items": {"type": "string", "minLength": 1}
            },
            "source": {"type": "object", "additionalProperties": true}
          },
          "additionalProperties": true
        },
        "fields": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": true
    },
    "item_error": {
      "type": "object",
      "required": ["scope", "code", "message"],
      "properties": {
        "scope": {"type": "string", "minLength": 1},
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "module": {"type": "string", "minLength": 1},
        "instance": {"type": "string", "minLength": 1},
        "port": {"type": "string", "minLength": 1},
        "surface": {"type": "string", "enum": ["full", "boundary"]},
        "values": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
