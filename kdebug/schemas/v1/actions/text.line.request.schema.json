{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kdebug.text.line.request.v1",
  "title": "text.line request",
  "type": "object",
  "required": [
    "api_version",
    "action",
    "target",
    "args"
  ],
  "properties": {
    "api_version": {
      "type": "string",
      "enum": [
        "kdebug.v1"
      ]
    },
    "request_id": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "text.line"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": true
    },
    "args": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "file",
        "line"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": true
    },
    "output": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
